TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_OWNER_ID=123456789
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
# sdk = opencode serve (bawaan), cli = opencode run
AGENT_RUNTIME=sdk
DATABASE_URL=file:./data/house.db
# folder hasil proyek; tanpa nilai ini proyek disimpan di apps/api/workspaces
WORKSPACES_DIR=D:/real-aihouse
MAX_CONCURRENT_RUNS=2
APPROVAL_TIMEOUT_MIN=30
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=secret_key_change_me
# auto = kerja otomatis tanpa minta izin (level 4 tetap ditolak), ask = tunggu persetujuan
AUTONOMY=auto
# profil kantor di dashboard: nama dan lokasi cuaca nyata (Open-Meteo)
HOUSE_NAME=Synectra AI House
HOUSE_CITY=Bandung
HOUSE_LATITUDE=-6.917
HOUSE_LONGITUDE=107.619
HOUSE_TIMEZONE=Asia/Jakarta
