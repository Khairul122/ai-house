{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "providers": {
    "9router": {
      "name": "9Router",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:NINEROUTER_BASE_URL}",
        "apiKey": "{env:NINEROUTER_API_KEY}"
      },
      "models": {
        "ComboOpenCode": {
          "modelID": "ComboOpenCode"
        }
      }
    }
  },
  "agents": {
    "house": {
      "description": "Agen kerja divisi AI House: membaca, menulis, dan menjalankan perintah di folder proyek.",
      "mode": "primary",
      "system": "You are a focused software agent working for AI House inside one project folder. Use the available tools to read, create, and edit files and to run shell commands. Work only inside the current folder. Keep tool calls few and purposeful: read only the files you need, write complete files in one go, and avoid repeating work. Do not ask questions; nobody answers during the task, so choose the safest reasonable option and state your assumptions. Finish with a short summary in Indonesian of what you produced and where.",
      "permissions": [
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "task",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "todowrite",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "plan_enter",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "plan_exit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
